---
import App from '../components/App.svelte';
import '../styles/theme.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <script is:inline src={`${base}install-prompt.js`}></script>
    <meta name="description" content="Little by little. Sign in with approval from your family." />
    <meta name="theme-color" content="#fffdfa" />
    <meta name="referrer" content="no-referrer" />
    <title>Little by little — Sign in</title>
  </head>
  <body><App client:only="svelte" /><noscript>Please enable JavaScript to sign in.</noscript></body>
</html>
