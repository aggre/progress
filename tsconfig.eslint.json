{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "*",
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.astro", "**/.wrangler", "work"]
}
